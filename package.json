{
  "name": "project-provenance",
  "productName": "Project Provenance",
  "description": "Local-first inventory of code projects and NilhanHub repository matches.",
  "author": "Nilhan.dev",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/cli.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx server/cli.ts",
    "server": "tsx server/cli.ts",
    "build": "tsc -b && vite build",
    "build:desktop-main": "esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "build:desktop": "npm run build && npm run build:desktop-main",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:portfolio": "tsx server/portfolio-audit.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.nilhan.projectprovenance",
    "productName": "Project Provenance",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples/seed-inventory.json",
        "to": "seed-inventory.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.svg",
      "artifactName": "Project-Provenance-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Project Provenance",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
